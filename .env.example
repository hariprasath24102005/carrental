# ====================================================================
# ANTI GRAVITY - ENVIRONMENT CONFIGURATION
# ====================================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
JWT_SECRET=super_secret_anti_gravity_jwt_key_2026

# DATABASE (PostgreSQL / Supabase)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:yourpassword@db.your-supabase-project.supabase.co:5432/postgres

# SMS / WHATSAPP NOTIFICATIONS (Twilio / WhatsApp Business API)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005554728
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=100200300400500

# STORAGE BUCKETS
SUPABASE_STORAGE_BUCKET_CARS=cars
SUPABASE_STORAGE_BUCKET_SERVICES=services
SUPABASE_STORAGE_BUCKET_BUSINESS=business
